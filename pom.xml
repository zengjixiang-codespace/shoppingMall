<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.codespace</groupId>
    <artifactId>shoppingMall</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <modules>
        <module>s-pay-mall-api</module>
        <module>s-pay-mall-application</module>
        <module>s-pay-mall-domain</module>
        <module>s-pay-mall-infrastructure</module>
        <module>s-pay-mall-common</module>
        <module>s-pay-mall-trigger</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 默认 JVM 参数，profile 激活时会被对应值覆盖 -->
        <java_jvm>-Xms1G -Xmx1G</java_jvm>
        <!-- 默认激活环境，与 dev profile 保持一致 -->
        <profileActive>dev</profileActive>
    </properties>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.3</version>
    </parent>

    <dependencyManagement>
        <dependencies>
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- MyBatis 与 Spring Boot 3.x 集成                                -->
            <!-- 提供 SqlSessionFactory 自动配置、MapperScanner 自动扫描         -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <dependency>
                <groupId>org.mybatis.spring.boot</groupId>
                <artifactId>mybatis-spring-boot-starter</artifactId>
                <version>3.0.4</version>
            </dependency>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- MySQL JDBC 驱动                                               -->
            <!-- 负责 Java 程序与 MySQL 数据库的网络协议通信                      -->
            <!-- TODO: artifactId 在 8.0.31 后已改为 mysql-connector-j           -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <dependency>
                <groupId>mysql</groupId>
                <artifactId>mysql-connector-java</artifactId>
                <version>8.0.33</version>
            </dependency>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- 阿里巴巴 Fastjson2：高性能 JSON 序列化/反序列化库（v2 重构版）  -->
            <!-- 用于 HTTP 接口的请求体解析、响应体组装、对象与 JSON 互转         -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <dependency>
                <groupId>com.alibaba.fastjson2</groupId>
                <artifactId>fastjson2</artifactId>
                <version>2.0.60</version>
            </dependency>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- Apache Commons Lang3：语言工具包                               -->
            <!-- 补充 JDK 缺少的 StringUtils、ArrayUtils、DateUtils 等工具方法   -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>3.17.0</version>
            </dependency>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- Google Guava：核心工具库                                       -->
            <!-- 提供不可变集合(ImmutableList)、本地缓存(Cache)、字符串处理等     -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>32.1.3-jre</version>
            </dependency>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- Dom4j：XML 解析库                                              -->
            <!-- 用于解析和处理 XML 文档（如微信支付回调报文、SOAP 接口）         -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <dependency>
                <groupId>dom4j</groupId>
                <artifactId>dom4j</artifactId>
                <version>1.6.1</version>
            </dependency>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- XStream：XML ↔ Java 对象互转库                                 -->
            <!-- 用于将 XML 字符串反序列化为 Java 对象，或将 Java 对象序列化为 XML -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <dependency>
                <groupId>com.thoughtworks.xstream</groupId>
                <artifactId>xstream</artifactId>
                <version>1.4.21</version>
            </dependency>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- JJWT：JSON Web Token 标准实现（Java 版）                       -->
            <!-- 用于生成和验证无状态用户认证 Token                              -->
            <!-- 0.12.x 已模块化，不再依赖 javax.xml.bind，完美兼容 Java 17+    -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>0.12.6</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>0.12.6</version>
                <scope>runtime</scope>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>0.12.6</version>
                <scope>runtime</scope>
            </dependency>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- Auth0 Java-JWT：JWT 的另一种实现                               -->
            <!-- 常用于验证第三方 OAuth/OIDC 签发的 Token（如 Auth0、Okta）       -->
            <!-- 注意：与 jjwt 功能重叠，后续建议二选一统一                       -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <dependency>
                <groupId>com.auth0</groupId>
                <artifactId>java-jwt</artifactId>
                <version>4.4.0</version>
            </dependency>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- Apache Commons Codec：编解码库                                 -->
            <!-- 提供 Base64、Hex、URL 编码/解码，以及 MD5、SHA 等摘要算法        -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <dependency>
                <groupId>commons-codec</groupId>
                <artifactId>commons-codec</artifactId>
                <version>1.15</version>
            </dependency>


            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- 工程模块（DDD 分层架构）                                       -->
            <!-- api=接口定义 | application=应用服务 | domain=领域模型            -->
            <!-- infrastructure=基础设施 | common=公共工具 | trigger=触发器      -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <dependency>
                <groupId>com.codespace</groupId>
                <artifactId>s-pay-mall-api</artifactId>
                <version>1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>com.codespace</groupId>
                <artifactId>s-pay-mall-application</artifactId>
                <version>1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>com.codespace</groupId>
                <artifactId>s-pay-mall-common</artifactId>
                <version>1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>com.codespace</groupId>
                <artifactId>s-pay-mall-domain</artifactId>
                <version>1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>com.codespace</groupId>
                <artifactId>s-pay-mall-infrastructure</artifactId>
                <version>1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>com.codespace</groupId>
                <artifactId>s-pay-mall-trigger</artifactId>
                <version>1.0-SNAPSHOT</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!--   maven-compiler-plugin（编译器插件）用途：控制 javac（Java 编译器）的行为，决定你的 .java 源代码如何被编译成 .class 字节码。-->
    <!--   maven-resources-plugin（资源插件）用途：处理 src/main/resources 目录下的配置文件（如 application.yml、Mapper.xml、properties 文件）的复制和过滤。 -->
    <!--   versions-maven-plugin（版本管理插件）用途：这是一个非常实用的运维辅助工具，方便你批量检查和管理依赖版本。-->
    <build>
        <pluginManagement>
            <plugins>
                <!--   插件会把 ${java_jvm} 里的内容传给 JVM -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <jvmArguments>${java_jvm}</jvmArguments>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>  <!-- 支持 Java 17+ -->
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                    <!-- 强烈建议开启，让 Spring Boot 反射时能获取参数名 -->
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <!-- 升级到 3.3.1，提高处理大文件时的内存效率 -->
                <version>3.3.1</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
                <!-- 升级到 2.16.2，支持 Spring Boot 4.x 的版本检测 -->
                <version>2.16.2</version>
            </plugin>
        </plugins>
    </build>

    <!--    jvm调优-->
    <profiles>
        <profile>
            <id>dev</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <java_jvm>
                    -Xms1G -Xmx1G -Xss512K
                    -Dspring.profiles.active=${profileActive}
                    -XX:+DisableExplicitGC
                    -XX:+UseG1GC
                    -XX:+HeapDumpOnOutOfMemoryError
                    -XX:HeapDumpPath=../docs/logs/s-pay-mall-boot
                    -Xlog:gc*:file=../docs/logs/s-pay-mall-boot/gc-s-pay-mall-boot.log
                </java_jvm>
                <profileActive>dev</profileActive>
            </properties>
        </profile>
        <profile>
            <id>test</id>
            <properties>
                <java_jvm>
                    -Xms1G -Xmx1G -Xss512K
                    -Dspring.profiles.active=${profileActive}
                    -XX:+DisableExplicitGC
                    -XX:+UseG1GC
                    -XX:+HeapDumpOnOutOfMemoryError
                    -XX:HeapDumpPath=/export/Logs/fq-mall-activity-app
                    -Xlog:gc*:file=/export/Logs/fq-mall-activity-app/gc-s-pay-mall-boot.log
                </java_jvm>
                <profileActive>test</profileActive>
            </properties>
        </profile>
        <profile>
            <id>prod</id>
            <properties>
                <java_jvm>
                    -Xms2G -Xmx2G -Xss512K
                    -Dspring.profiles.active=${profileActive}
                    -XX:+DisableExplicitGC
                    -XX:+UseG1GC
                    -XX:+HeapDumpOnOutOfMemoryError
                    -XX:HeapDumpPath=/export/Logs/fq-mall-activity-app
                    -Xlog:gc*:file=/export/Logs/fq-mall-activity-app/gc-s-pay-mall-boot.log
                </java_jvm>
                <profileActive>prod</profileActive>
            </properties>
        </profile>
    </profiles>

</project>